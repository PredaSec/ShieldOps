# =============================================================================
# SECURE VARIANT — fixes V5
# Changes vs the insecure Dockerfile:
#   1. Up-to-date pinned base image: node:20.14.0-alpine3.20 (current LTS).
#   2. Runs as a non-root user (node, uid 1000) so RCE cannot escalate to root.
#   3. Copies only what is needed (no src directly into /app root — uses subdir).
# =============================================================================

FROM node:20.14.0-alpine3.20

# Create a dedicated app directory owned by the built-in 'node' user.
WORKDIR /app

# Install deps as root first (npm requires write access to node_modules),
# then drop privileges.
COPY package.json ./
RUN npm install --production && chown -R node:node /app

COPY --chown=node:node src/ ./src/

# V5 FIX: explicit non-root user
USER node

EXPOSE 3001

CMD ["node", "src/index.js"]

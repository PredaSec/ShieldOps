{
  "id": null,
  "uid": "shieldops-app-health",
  "title": "ShieldOps — Application Health",
  "description": "Request rate, latency, error rate, and pod status for the ShieldOps backend",
  "tags": ["shieldops", "app", "health"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Running Pods (development)",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{namespace=\"development\",phase=\"Running\"})",
          "legendFormat": "Running Pods",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 1},
              {"color": "green", "value": 3}
            ]
          },
          "color": {"mode": "thresholds"},
          "mappings": []
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Running Pods (production)",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{namespace=\"production\",phase=\"Running\"})",
          "legendFormat": "Running Pods",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 1},
              {"color": "green", "value": 5}
            ]
          },
          "color": {"mode": "thresholds"},
          "mappings": []
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pod Restarts (all namespaces)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "sum(kube_pod_container_status_restarts_total{namespace=~\"development|staging|production\"})",
          "legendFormat": "Total Restarts",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 5},
              {"color": "red", "value": 20}
            ]
          },
          "color": {"mode": "thresholds"},
          "mappings": []
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Node CPU Usage %",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "area",
        "unit": "percent"
      },
      "targets": [
        {
          "expr": "100 - (avg by(instance)(irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU %",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 60},
              {"color": "red", "value": 80}
            ]
          },
          "color": {"mode": "thresholds"},
          "mappings": []
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pod Status Over Time (development namespace)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "count by(phase) (kube_pod_status_phase{namespace=\"development\"})",
          "legendFormat": "{{phase}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Node Memory Usage",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / 1024 / 1024",
          "legendFormat": "Used MB",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        },
        {
          "expr": "node_memory_MemAvailable_bytes / 1024 / 1024",
          "legendFormat": "Available MB",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mbytes",
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP Request Rate (backend /metrics — requires prom-client)",
      "description": "Requires the Phase 2 backend to expose /metrics via prom-client. Until then, panel shows no data.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "sum by(route, method, status_code) (rate(http_requests_total{job=\"shieldops-backend\"}[5m]))",
          "legendFormat": "{{method}} {{route}} {{status_code}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Backend HTTP Error Rate (requires prom-client)",
      "description": "Requires the Phase 2 backend to expose /metrics via prom-client.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"shieldops-backend\",status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"shieldops-backend\"}[5m])) * 100",
          "legendFormat": "Error Rate %",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {"lineWidth": 2, "fillOpacity": 10},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Backend Application Logs (Loki)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20},
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "enableLogDetails": true
      },
      "targets": [
        {
          "expr": "{namespace=\"development\", container=\"backend\"}",
          "legendFormat": "",
          "datasource": {"type": "loki", "uid": "loki"}
        }
      ]
    }
  ]
}

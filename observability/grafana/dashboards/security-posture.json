{
  "id": null,
  "uid": "shieldops-security-posture",
  "title": "ShieldOps — Security Posture",
  "description": "CVE counts, Semgrep findings, Falco alert frequency, and security events from Loki",
  "tags": ["shieldops", "security", "falco", "trivy"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Falco Alerts (last 6h)",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "options": {
        "reduceOptions": {"calcs": ["sum"]},
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "count_over_time({namespace=\"monitoring\", container=\"falco\"} |= \"Output:\" [6h])",
          "legendFormat": "Falco Alerts",
          "datasource": {"type": "loki", "uid": "loki"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 10}
            ]
          },
          "color": {"mode": "thresholds"},
          "mappings": []
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Critical Falco Alerts (last 6h)",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "options": {
        "reduceOptions": {"calcs": ["sum"]},
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "count_over_time({namespace=\"monitoring\", container=\"falco\"} |= \"Priority: Critical\" [6h])",
          "legendFormat": "Critical Alerts",
          "datasource": {"type": "loki", "uid": "loki"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "red", "value": 1}
            ]
          },
          "color": {"mode": "thresholds"},
          "mappings": []
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Shell-in-Container Events (last 6h)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "options": {
        "reduceOptions": {"calcs": ["sum"]},
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "count_over_time({namespace=\"monitoring\", container=\"falco\"} |= \"shell\" [6h])",
          "legendFormat": "Shell Events",
          "datasource": {"type": "loki", "uid": "loki"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "orange", "value": 1},
              {"color": "red", "value": 5}
            ]
          },
          "color": {"mode": "thresholds"},
          "mappings": []
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Sensitive Path Write Events (last 6h)",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "options": {
        "reduceOptions": {"calcs": ["sum"]},
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "count_over_time({namespace=\"monitoring\", container=\"falco\"} |= \"sensitive\" [6h])",
          "legendFormat": "Sensitive Write Events",
          "datasource": {"type": "loki", "uid": "loki"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "red", "value": 1}
            ]
          },
          "color": {"mode": "thresholds"},
          "mappings": []
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Falco Alert Frequency Over Time",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 4},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "sum(count_over_time({namespace=\"monitoring\", container=\"falco\"} |= \"Output:\" [5m]))",
          "legendFormat": "All Falco Alerts",
          "datasource": {"type": "loki", "uid": "loki"}
        },
        {
          "expr": "sum(count_over_time({namespace=\"monitoring\", container=\"falco\"} |= \"shell\" [5m]))",
          "legendFormat": "Shell-in-Container",
          "datasource": {"type": "loki", "uid": "loki"}
        },
        {
          "expr": "sum(count_over_time({namespace=\"monitoring\", container=\"falco\"} |= \"sensitive\" [5m]))",
          "legendFormat": "Sensitive Path Write",
          "datasource": {"type": "loki", "uid": "loki"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        }
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Falco Security Events (Live)",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 12},
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "enableLogDetails": true
      },
      "targets": [
        {
          "expr": "{namespace=\"monitoring\", container=\"falco\"}",
          "legendFormat": "",
          "datasource": {"type": "loki", "uid": "loki"}
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Node CPU Usage (security overhead indicator)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "100 - (avg by(instance)(irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU %",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        }
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Trivy / Security Scan CI Logs",
      "description": "Security scan output shipped to Loki from CI pipelines",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22},
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true
      },
      "targets": [
        {
          "expr": "{job=\"security-scans\"} |= \"CRITICAL\"",
          "legendFormat": "",
          "datasource": {"type": "loki", "uid": "loki"}
        }
      ]
    }
  ]
}

# ShieldOps Dashboard — environment variables
# Copy to .env and fill in values before running docker compose

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=dashboard-postgres
DB_PORT=5432
DB_NAME=shieldops_dashboard
DB_USER=dashboard
DB_PASSWORD=change_me_strong_password_here

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_random_256bit_secret
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change_me_strong_password_here

# ── AI Service (Phase 4) ──────────────────────────────────────────────────────
# URL of the Phase 4 AI analysis service
AI_SERVICE_URL=http://shieldops-ai:3000

# ── GitLab webhook token ──────────────────────────────────────────────────────
# Set this on the GitLab project webhook too (Settings → Webhooks → Secret token)
GITLAB_WEBHOOK_TOKEN=your_gitlab_webhook_secret_here

# ── SMTP (Nodemailer) ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password_here
SMTP_FROM=shieldops@example.com

# ── Notification recipients ───────────────────────────────────────────────────
NOTIFICATION_RECIPIENTS=ops@example.com,security@example.com

# ── External tool links ───────────────────────────────────────────────────────
LINK_GRAFANA=http://localhost:3000
LINK_PROMETHEUS=http://localhost:9090
LINK_LOKI=http://localhost:3100
LINK_ZAP=http://localhost:8080/zap/
LINK_TRIVY=
LINK_SEMGREP=
LINK_GITLAB=http://localhost:8929/root/shieldops

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8088,http://localhost:5173

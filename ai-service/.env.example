# ============================================================================
# ShieldOps AI Analysis Service — Environment Variables
# ============================================================================
# Copy to .env and fill in your values. NEVER commit .env to git.

# ---- Gemini AI (required for live analysis) --------------------------------
# Get a free API key at: https://aistudio.google.com/app/apikey
# In GitLab CI: set as a masked CI/CD variable (Settings → CI/CD → Variables)
# Name: GEMINI_API_KEY  |  Type: Variable  |  Masked: yes  |  Protected: yes
GEMINI_API_KEY=

# Optional: override model (default: gemini-1.5-flash — free tier)
# Alternatives: gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# ---- S3 / LocalStack -------------------------------------------------------
# LocalStack (local dev):
AWS_ENDPOINT_URL=http://localstack:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_REPORTS_BUCKET=shieldops-reports

# Real AWS (Phase 7):
# AWS_ENDPOINT_URL=           # leave empty for real AWS
# AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=          # use IAM role or env in production
# AWS_SECRET_ACCESS_KEY=

# ---- HTTP Server -----------------------------------------------------------
PORT=3000

# ---- Dashboard Integration (Phase 5) ---------------------------------------
# POST the AI report JSON to the dashboard API on completion
DASHBOARD_API_URL=

# ---- Pipeline Metadata (auto-set by GitLab CI) ----------------------------
# CI_PIPELINE_ID=
# CI_COMMIT_SHA=

# OpenRouter (preferred AI provider — OpenAI-compatible, free models available).
# Get a key at https://openrouter.ai/keys . Takes precedence over GEMINI_API_KEY.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
